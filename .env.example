# StockMind — Variables de entorno
# Copia este archivo como .env y reemplaza TODOS los valores.
# .env NO se sube al repositorio.
#
# Generar un valor aleatorio fuerte:   openssl rand -hex 32

# ─── MySQL ───────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=cambia_esto
MYSQL_USER=stockmind_app
MYSQL_PASSWORD=cambia_esto

# ─── JWT (compartido por gateway y backend; mínimo 32 caracteres) ────────────
JWT_SECRET=cambia_esto_por_openssl_rand_hex_32
JWT_EXPIRATION=86400000

# ─── Gateway / Frontend ──────────────────────────────────────────────────────
NODE_ENV=development
# Detrás de un proxy inverso/balanceador (producción): número de proxies, ej. 1
TRUST_PROXY=
FRONTEND_URL=http://localhost:5173
VITE_GATEWAY_URL=http://localhost:3000

# ─── Asistente IA (opcional) ─────────────────────────────────────────────────
GROQ_API_KEY=
# El asistente está en reconstrucción: déjalo en false hasta reactivarlo
AGENT_ENABLED=false
