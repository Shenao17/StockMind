# StockMind — Variables de entorno
# Copia este archivo como .env y reemplaza TODOS los valores.
# .env NO se sube al repositorio.
#
# Generar un valor aleatorio fuerte:   openssl rand -hex 32

# ─── MySQL ───────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=cambia_esto
MYSQL_USER=stockmind_app
MYSQL_PASSWORD=cambia_esto

# ─── JWT (compartido por gateway y backend; mínimo 32 caracteres) ────────────
JWT_SECRET=cambia_esto_por_openssl_rand_hex_32
JWT_EXPIRATION=86400000

# ─── Dueño de la plataforma (se crea al arrancar el backend, solo si aún no existe) ──
# Contraseña: 8-72 caracteres con letra y número. Déjalas vacías para no crearlo.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# ─── Registro público: protección anti-bots ──────────────────────────────────
# none      = sin CAPTCHA (SOLO desarrollo; en producción el registro público se desactiva)
# turnstile = Cloudflare Turnstile (gratuito); requiere TURNSTILE_SECRET
CAPTCHA_PROVIDER=none
TURNSTILE_SECRET=

# ─── Clave interna gateway ↔ analytics (mínimo 32 caracteres) ────────────────
# Analytics solo atiende peticiones del gateway que traigan esta clave.
INTERNAL_API_KEY=cambia_esto_por_openssl_rand_hex_32

# ─── Gateway / Frontend ──────────────────────────────────────────────────────
NODE_ENV=development
# Detrás de un proxy inverso/balanceador (producción): número de proxies, ej. 1
TRUST_PROXY=
FRONTEND_URL=http://localhost:5173
VITE_GATEWAY_URL=http://localhost:3000

# ─── Asistente IA (opcional) ─────────────────────────────────────────────────
GROQ_API_KEY=
# El asistente está en reconstrucción: déjalo en false hasta reactivarlo
AGENT_ENABLED=false
